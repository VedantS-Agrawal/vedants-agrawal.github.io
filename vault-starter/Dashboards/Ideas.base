filters:
  or:
    - type == "concept"
    - type == "evergreen"
    - type == "literature-note"
views:
  - type: table
    name: Ideas
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - maturity
      - tags
      - visibility
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Reading notes
    filters:
      and:
        - type == "literature-note"
    order:
      - file.name
      - about
      - created
      - visibility
    sort:
      - property: created
        direction: DESC
