filters:
  or:
    - type == "literature"
    - type == "literature-note"
views:
  - type: table
    name: Shelf
    filters:
      and:
        - type == "literature"
    groupBy:
      property: consumption_status
      direction: ASC
    order:
      - file.name
      - creator
      - medium
      - finished
      - visibility
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Covers
    filters:
      and:
        - type == "literature"
    order:
      - file.name
      - creator
    image: note.cover
  - type: table
    name: Reading notes
    filters:
      and:
        - type == "literature-note"
    order:
      - file.name
      - about
      - created
      - visibility
    sort:
      - property: created
        direction: DESC
